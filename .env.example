# Koala UI — environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Only the NEXT_PUBLIC_* vars below are read by the Next.js app. The rest are
# documented at the bottom for the CLI / registry build and are NOT read from
# this file — set them in your shell when you need them.

# ── /pro storefront ──────────────────────────────────────────────────────────

# Stripe Payment Link (one-time, lifetime purchase). The "Buy" button on /pro
# links here. If unset it falls back to "#" so the button is never dead.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Supabase Edge Functions base, e.g. https://<project-ref>.supabase.co/functions/v1
# The /pro/success page polls the stripe-webhook GET endpoint here until the
# webhook has minted the license key.
NEXT_PUBLIC_KOALA_FUNCTIONS_URL=

# ── build / CLI (shell env, not loaded from this file) ───────────────────────
#
# KOALA_PRO_DIR   Path to the private koala-ui-pro checkout used by
#                 `npm run registry`. Defaults to ../koala-ui-pro (sibling dir).
#                 If absent, only the free tier is emitted into registry.json.
#
# KOALAUI_LICENSE License key consumed by the published `koalaui` CLI when
#                 pulling PRO source. End-user facing; also settable via --license.
#
# KOALAUI_API     Entitlement API base for the `koalaui` CLI. Has a built-in
#                 default; override via this var or the --api flag.
